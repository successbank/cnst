                            <?php 
                            // 항상 기준단가를 기준으로 계산
                            $min_price = $product['price'] * 0.9;
                            $max_price = $product['price'] * 1.1;
                            echo number_format($min_price, 0) . '원 ~ ' . number_format($max_price, 0) . '원';
                            ?>
                        </div>
                    </div>
                    <?php endif; ?>
                    
                    <?php if ($product['specification_weight']): ?>
                    <div class="detail-item">
                        <div class="detail-label">단위중량</div>
                        <div class="detail-value unit-weight-highlight">
                            <?php echo htmlspecialchars($product['specification_weight']); ?> kg/m
                        </div>
                    </div>
                    <?php endif; ?>
                    
                    
                    <?php if ($product['has_calculator']): ?>
                    <!-- 실시간 중량 계산기 섹션 -->
                    <div class="calculator-section">
                        <h3 class="calculator-title">📊 실시간 중량 계산기</h3>
                        
                        <?php if ($product['category_code'] === 'rebar'): ?>
                        <!-- 철근 번들 계산기 추가 -->
                        <?php
                        // 철근 규격 추출 - specifications 필드 우선 사용
                        $rebar_spec = '';
                        if (!empty($product['specifications'])) {
                            $rebar_spec = $product['specifications'];
                        } else {
                            // specifications이 없으면 product_name에서 추출
                            preg_match('/(H?D\d+)/', $product['product_name'], $matches);
                            $rebar_spec = isset($matches[1]) ? $matches[1] : '';
                        }
                        
                        // 재질 추출 - available_materials 배열의 첫 번째 값 또는 기본값 사용
                        $available_materials_for_rebar = json_decode($product['available_materials'] ?? '[]', true);
                        $rebar_material = !empty($available_materials_for_rebar[0]) ? $available_materials_for_rebar[0] : 'SD400';
                        
                        // 실제 사용 가능한 재질 목록 조회
                        $actual_materials = [];
                        if ($rebar_spec) {
                            $materials_stmt = $pdo->prepare("
                                SELECT DISTINCT p_material 
                                FROM rebar_bundle_data 
                                WHERE p_standard = ?
                                ORDER BY p_material
                            ");
                            $materials_stmt->execute([$rebar_spec]);
                            $actual_materials = $materials_stmt->fetchAll(PDO::FETCH_COLUMN);
                        }
                        
                        // 번들 데이터 조회 (재질과 무관하게 규격으로만)
                        $bundle_data = [];
                        
                        if ($rebar_spec) {
                            // 규격에 해당하는 번들 데이터 가져오기 (재질 무관)
                            $bundle_stmt = $pdo->prepare("
                                SELECT DISTINCT p_unit_length, p_bd_count, p_bd_weight 
                                FROM rebar_bundle_data 
                                WHERE p_standard = ? 
                                AND p_bd_count > 0 AND p_bd_weight > 0
                                ORDER BY p_unit_length
                            ");
                            $bundle_stmt->execute([$rebar_spec]);
                            while ($row = $bundle_stmt->fetch(PDO::FETCH_ASSOC)) {
                                $bundle_data[$row['p_unit_length']] = [
                                    'bd_count' => $row['p_bd_count'],
                                    'bd_weight' => $row['p_bd_weight']
                                ];
                            }
                        }
                        
                        // 재질별, 원산지별 추가단가 조회
                        $material_prices = [];
                        $country_prices = [];
                        
                        $stmt = $pdo->query("SELECT material, additional_price FROM rebar_material_prices WHERE is_active = 1");
                        while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                            $material_prices[$row['material']] = $row['additional_price'];
                        }
                        
                        $stmt = $pdo->query("SELECT country, additional_price FROM rebar_country_prices WHERE is_active = 1");
                        while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                            $country_prices[$row['country']] = $row['additional_price'];
                        }
                        ?>
                        
                        <div style="margin-bottom: 20px; padding: 15px; background: #e3f2fd; border-radius: 8px; border: 1px solid #90caf9;">
                            <strong style="color: #1565c0;">📦 번들 단위 판매</strong><br>
                            <span style="font-size: 14px; color: #555;">철근은 번들 단위로만 판매됩니다. 길이별로 번들당 본수와 중량이 정해져 있습니다.</span>
                            <?php if (empty($bundle_data)): ?>
                            <br><span style="color: #d32f2f; font-weight: bold;">⚠️ 현재 번들 데이터를 불러올 수 없습니다. 고객센터로 문의해주세요.</span>
                            <?php endif; ?>
                        </div>
                        
                        <script>
                        // 철근 전용 변수들은 이미 전역으로 선언됨
                        </script>
                        <?php endif; ?>
                        
                        <div class="inline-calculator">
                            <div class="calc-form-row">
                                <?php if (!empty($product['available_origins'])): ?>
                                <?php 
                                $origins = json_decode($product['available_origins'], true) ?: [];
                                if (count($origins) > 0): 
                                ?>
                                <div class="calc-form-group">
                                    <label>원산지 선택</label>
                                    <select id="origin-select" class="calc-control">
                                        <option value="">원산지를 선택하세요</option>
                                        <?php foreach ($origins as $index => $origin): ?>
                                        <option value="<?php echo htmlspecialchars($origin); ?>"
                                                <?php echo ($index === 0) ? 'selected' : ''; ?>>
                                            <?php echo htmlspecialchars($origin); ?>
                                        </option>
                                        <?php endforeach; ?>
                                    </select>
                                </div>
                                <?php endif; ?>
                                <?php endif; ?>
                                
                                <div class="calc-form-group">
                                    <label>재질 선택</label>
                                    <select id="calc-material" class="calc-control">
                                        <?php 
                                        // 철근인 경우 제품에 설정된 모든 재질 표시
                                        if ($product['category_code'] === 'rebar' && !empty($available_materials_for_rebar)):
                                            foreach ($available_materials_for_rebar as $index => $material): 
                                        ?>
                                        <option value="<?php echo htmlspecialchars($material); ?>" 
                                                <?php echo ($index === 0) ? 'selected' : ''; ?>>
                                            <?php echo htmlspecialchars($material); ?>
                                        </option>
                                        <?php 
                                            endforeach;
                                        else:
                                            // 철근이 아닌 경우 기존 로직 사용
                                            // available_materials가 있으면 사용, 없으면 available_materials 컬럼에서 가져옴
                                            if (empty($available_materials) && !empty($product['available_materials'])) {
                                                $available_materials = json_decode($product['available_materials'], true) ?: [];
                                            }
                                            
                                            if (!empty($available_materials)):
                                                // 첫 번째 재질을 기본값으로
                                                foreach ($available_materials as $index => $material): 
                                        ?>
                                        <option value="<?php echo htmlspecialchars($material); ?>" 
                                                <?php echo ($index === 0) ? 'selected' : ''; ?>>
                                            <?php echo htmlspecialchars($material); ?>
                                        </option>
                                        <?php 
                                                endforeach;
                                            else:
                                        ?>
                                        <option value="">재질 선택</option>
                                        <?php 
                                            endif;
                                        endif; 
                                        ?>
                                    </select>
                                </div>
                                
                                <?php if ($calculation_type === 'linear'): ?>
                                <div class="calc-form-group" id="length-group">
                                    <?php if ($product['category_code'] === 'rebar'): ?>
                                    <!-- 철근은 번들 모드가 기본값이므로 select로 표시 -->
                                    <label>길이 선택</label>
                                    <select id="calc-length" class="calc-control">
                                        <option value="">길이를 선택하세요</option>
                                        <?php foreach ($bundle_data as $length => $info): ?>
                                        <option value="<?php echo $length; ?>">
                                            <?php echo $length; ?>m (번들당 <?php echo $info['bd_count']; ?>본, <?php echo $info['bd_weight']; ?>kg)
                                        </option>
                                        <?php endforeach; ?>
                                    </select>
                                    <div id="bundle-info" style="margin-top: 10px; font-size: 14px; color: #666;"></div>
                                    <?php else: ?>
                                    <label>길이 (미터)</label>
                                    <input type="number" id="calc-length" class="calc-control" 
                                           min="0.1" step="0.1" placeholder="예: 6" value="">
                                    <?php endif; ?>
                                </div>
                                <?php endif; ?>
                                
                                <div class="calc-form-group">
                                    <label for="calc-quantity"><?php echo ($product['category_code'] === 'rebar') ? '번들 수량' : '수량 (' . ($calculation_type === 'linear' ? '본' : '장') . ')'; ?></label>
                                    <input type="number" id="calc-quantity" class="calc-control" 
                                           min="1" placeholder="예: 10" value="1">
                                </div>
                            </div>
                            
                            <!-- 실시간 계산 결과 -->
                            <div class="calc-result" id="calcResult" style="display: none;">
                                <div class="calc-result-header">계산 결과</div>
                                <div class="calc-result-value" id="calcResultValue">0 kg</div>
                                <div class="calc-result-price" id="calcResultPrice">견적금액: 0원</div>
                                <div class="calc-steps" id="calcSteps"></div>
                            </div>
                        </div>
                    </div>
                    
                    <script>
                    // 계산기 데이터
                    const calculatorData = {
                        unitWeightData: <?php echo json_encode($unit_weight_data, JSON_UNESCAPED_UNICODE); ?>,
                        specification: '<?php echo htmlspecialchars($product['specifications'] ?? $product['specification'] ?? ''); ?>',
                        calculationType: '<?php echo $calculation_type; ?>',
                        unitWeight: <?php echo $product['specification_weight'] ?? 0; ?>
                    };
                    
                    // 원산지별 추가 비용 데이터
                    const originPriceData = <?php echo !empty($product['origin_price_data']) ? $product['origin_price_data'] : '{}'; ?>;
                    
                    // 재질별 추가 비용 데이터
                    const materialPriceData = <?php echo !empty($product['material_price_data']) ? $product['material_price_data'] : '{}'; ?>;
                    
                    // 철근 관련 변수들 (철근이 아닌 경우 빈 값)
                    <?php if ($product['category_code'] === 'rebar'): ?>
                    const bundleData = <?php echo json_encode($bundle_data); ?>;
                    const materialPrices = <?php echo json_encode($material_prices); ?>;
                    const countryPrices = <?php echo json_encode($country_prices); ?>;
                    const rebarSpec = '<?php echo $rebar_spec; ?>';
                    const rebarUnitWeight = <?php echo $product['specification_weight'] ?? 0; ?>;
                    <?php else: ?>
                    const bundleData = {};
                    const materialPrices = {};
                    const countryPrices = {};
                    const rebarSpec = '';
                    const rebarUnitWeight = 0;
                    <?php endif; ?>
                    
                    // 함수 선언을 여기에 추가 (has_calculator 조건 전에)
                    <?php if ($product['category_code'] === 'rebar'): ?>
                    // 번들 정보 업데이트
                    function updateBundleInfo() {
                        const length = parseFloat(document.getElementById('calc-length').value);
                        const infoDiv = document.getElementById('bundle-info');
                        
                        if (length && bundleData[length]) {
                            infoDiv.innerHTML = `<strong style="color: #0066cc;">선택된 번들: ${bundleData[length].bd_count}본, ${bundleData[length].bd_weight}kg</strong>`;
                        } else {
                            infoDiv.innerHTML = '';
                        }
                    }
                    
                    <?php endif; ?>
                    </script>
                    <?php endif; ?>
                </div>
            </div>
        </div>
        
        <!-- 제품 상세보기 섹션 -->
        <div class="product-detail-info-section">
            <div class="section-header">
                <h2>제품 상세보기</h2>
            </div>
            <div class="detail-info-grid">
                <div class="info-item">
                    <div class="info-label">주식회사 충남스틸</div>
                    <div class="info-value">구조용 강관 전문 공급업체</div>
                </div>
                <div class="info-item">
                    <div class="info-label">고객센터</div>
                    <div class="info-value">032-564-1616</div>
                </div>
                <div class="info-item">
                    <div class="info-label">영업시간</div>
                    <div class="info-value">평일 09:00 - 18:00</div>
                </div>
                <div class="info-item">
                    <div class="info-label">바로가기</div>
                    <div class="info-value">
                        <a href="/products_new.php?category=<?php echo htmlspecialchars($product['category_code']); ?>"><?php echo htmlspecialchars($product['category_name']); ?> 전체보기</a> | 
                        <a href="/contact.php">견적문의</a>
                    </div>
                </div>
                <?php if (!empty($product['features'])): ?>
                <div class="info-item">
                    <div class="info-label">제품 용도</div>
                    <div class="info-value"><?php echo htmlspecialchars($product['features']); ?></div>
                </div>
                <?php endif; ?>
                <?php if (!empty($product['quality_cert'])): ?>
                <div class="info-item">
                    <div class="info-label">품질 인증</div>
                    <div class="info-value"><?php echo htmlspecialchars($product['quality_cert']); ?></div>
                </div>
                <?php endif; ?>
                <?php if (!empty($product['material'])): ?>
                <div class="info-item">
                    <div class="info-label">기본 재질</div>
                    <div class="info-value"><?php echo htmlspecialchars($product['material']); ?></div>
                </div>
                <?php endif; ?>
                <?php if (!empty($product['available_materials']) && $product['available_materials'] !== '[]'): ?>
                <div class="info-item">
                    <div class="info-label">판매 가능 재질</div>
                    <div class="info-value">
                        <?php 
                        $materials = json_decode($product['available_materials'], true) ?: [];
                        echo implode(', ', $materials);
                        ?>
                    </div>
                </div>
                <?php endif; ?>
                <?php if (!empty($product['manufacturer'])): ?>
                <div class="info-item">
                    <div class="info-label">제조사</div>
                    <div class="info-value"><?php echo htmlspecialchars($product['manufacturer']); ?></div>
                </div>
                <?php endif; ?>
                <?php if (!empty($product['product_features'])): ?>
                <div class="info-item">
                    <div class="info-label">특징</div>
                    <div class="info-value"><?php echo htmlspecialchars($product['product_features']); ?></div>
                </div>
                <?php endif; ?>
                <?php if (!empty($product['delivery_info'])): ?>
                <div class="info-item">
                    <div class="info-label">배송 정보</div>
                    <div class="info-value"><?php echo nl2br(htmlspecialchars($product['delivery_info'])); ?></div>
                </div>
                <?php endif; ?>
                <?php if (!empty($product['description'])): ?>
                <div class="info-item full-width">
                    <div class="info-label">제품 설명</div>
                    <div class="info-value">
                        <?php
                        // 설명을 줄 단위로 분리
                        $lines = explode("\n", $product['description']);
                        foreach ($lines as $line) {
                            $line = trim($line);
                            if (empty($line)) continue;
                            
                            // 이미지 파일 확장자 패턴
                            if (preg_match('/\.(jpg|jpeg|png|gif|webp)$/i', $line)) {
                                // 이미지 경로인 경우
                                echo '<img src="' . htmlspecialchars($line) . '" alt="제품 이미지" style="max-width: 100%; height: auto; margin: 10px 0;">';
                            } else {
                                // 일반 텍스트인 경우
                                echo nl2br(htmlspecialchars($line)) . '<br>';
                            }
                        }
                        ?>
                    </div>
                </div>
                <?php endif; ?>
            </div>
        </div>
        </div>
    </div>
    
    <?php if ($product['has_calculator']): ?>
    <script>
    
    // 실시간 계산 기능
    function calculateWeight() {
        const materialSelect = document.getElementById('calc-material');
        const material = materialSelect ? materialSelect.value : '';
        const quantity = parseInt(document.getElementById('calc-quantity').value) || 0;
        const lengthInput = document.getElementById('calc-length');
        const length = lengthInput ? (parseFloat(lengthInput.value) || 0) : 0;
        
        // 선택된 원산지 가져오기
        const originSelect = document.getElementById('origin-select');
        const selectedOrigin = originSelect ? originSelect.value : '';
        
        // 디버깅을 위한 로그
        console.log('calculateWeight called:', {
            material, quantity, length, selectedOrigin,
            categoryCode: '<?php echo $product['category_code']; ?>',
            bundleData: typeof bundleData !== 'undefined' ? bundleData : 'undefined'
        });
        
        // 입력값 검증
        if (quantity <= 0) {
            document.getElementById('calcResult').style.display = 'none';
            return;
        }
        
        if (calculatorData.calculationType === 'linear' && length <= 0) {
            document.getElementById('calcResult').style.display = 'none';
            return;
        }
        
        // 단위 중량 가져오기
        let unitWeight = calculatorData.unitWeight;
        
        // 계산기 데이터에서 단위 중량 찾기
        if (calculatorData.unitWeightData && calculatorData.specification) {
            const specData = calculatorData.unitWeightData[calculatorData.specification];
            if (specData) {
                if (material && specData[material]) {
                    unitWeight = specData[material];
                } else {
                    // 첫 번째 재질의 단위중량 사용
                    unitWeight = Object.values(specData)[0] || unitWeight;
                }
            }
        }
        
        // 중량 계산
        let calculatedWeight = 0;
        let calculationSteps = [];
        let totalPrice = 0;
        
        <?php if ($product['category_code'] === 'rebar'): ?>
        // 철근 제품 계산
        if (typeof bundleData !== 'undefined' && bundleData[length]) {
            // 번들 모드 계산
            const bundleInfo = bundleData[length];
            const totalBundles = quantity;
            const totalPieces = totalBundles * bundleInfo.bd_count;
            calculatedWeight = totalBundles * bundleInfo.bd_weight;
            
            calculationSteps = [
                `번들당 정보: ${bundleInfo.bd_count}본, ${bundleInfo.bd_weight}kg`,
                `총 번들 수: ${totalBundles}번들`,
                `총 본수: ${totalBundles} × ${bundleInfo.bd_count} = ${totalPieces}본`,
                `총 중량: ${totalBundles} × ${bundleInfo.bd_weight}kg = ${calculatedWeight.toFixed(1)} kg`
            ];
            
            // 철근 가격 계산
            const basePricePerKg = 700;
            let materialAdditional = 0;
            let originAdditional = 0;
            
            if (material && materialPrices[material] !== undefined) {
                materialAdditional = parseFloat(materialPrices[material]);
            }
            
            if (selectedOrigin && countryPrices[selectedOrigin] !== undefined) {
                originAdditional = parseFloat(countryPrices[selectedOrigin]);
            }
            
            const totalPricePerKg = basePricePerKg + materialAdditional + originAdditional;
            totalPrice = calculatedWeight * totalPricePerKg;
            
            calculationSteps.push('');
            calculationSteps.push(`기본 단가: ${basePricePerKg}원/kg`);
            if (materialAdditional !== 0) {
                calculationSteps.push(`재질(${material}) 추가: ${materialAdditional > 0 ? '+' : ''}${materialAdditional}원/kg`);
            }
            if (originAdditional !== 0) {
                calculationSteps.push(`원산지(${selectedOrigin}) 추가: ${originAdditional > 0 ? '+' : ''}${originAdditional}원/kg`);
            }
            calculationSteps.push(`최종 단가: ${totalPricePerKg}원/kg`);
            calculationSteps.push(`총 금액: ${calculatedWeight.toFixed(1)}kg × ${totalPricePerKg}원 = ${totalPrice.toLocaleString()}원`);
            
            // 결과 표시
            document.getElementById('calcResultValue').textContent = calculatedWeight.toFixed(1) + ' kg';
            document.getElementById('calcResultPrice').textContent = '견적금액: ' + totalPrice.toLocaleString() + '원';
        } else {
            // 번들 정보가 없는 경우
            document.getElementById('calcResultValue').textContent = '계산 불가';
            document.getElementById('calcResultPrice').textContent = '';
            
            const errorMessage = length ? 
                '선택하신 길이의 번들 데이터가 없습니다.' : 
                '길이를 선택해주세요.';
            
            calculationSteps = [`⚠️ ${errorMessage}`];
        }
        
        // 계산 과정 표시
        const stepsHtml = calculationSteps.map(step => 
            `<div class="calc-step">${step}</div>`
        ).join('');
        document.getElementById('calcSteps').innerHTML = stepsHtml;
        document.getElementById('calcResult').style.display = 'block';
        
        <?php else: ?>
        // 일반 제품 계산
        if (calculatorData.calculationType === 'linear') {
            // 선형 제품: 단위중량 × 길이 × 수량
            const weightPerPiece = unitWeight * length;
            calculatedWeight = weightPerPiece * quantity;
            
            calculationSteps = [
                `단위중량: ${unitWeight} kg/m`,
                `1본 중량: ${unitWeight} × ${length}m = ${weightPerPiece.toFixed(2)} kg`,
                `총 중량: ${weightPerPiece.toFixed(2)} × ${quantity}본 = ${calculatedWeight.toFixed(1)} kg`
            ];
        } else {
            // 판재 제품: 단위중량(장) × 수량
            calculatedWeight = unitWeight * quantity;
            
            calculationSteps = [
                `단위중량(장): ${unitWeight} kg`,
                `총 중량: ${unitWeight} × ${quantity}장 = ${calculatedWeight.toFixed(1)} kg`
            ];
        }
        
        // 가격 계산 (일반 제품용)
        let basePrice;
        
        <?php if ($product['category_code'] !== 'rebar'): ?>
        // 일반 제품 가격 계산
        const pricePerKg = 1000; // 기본 kg당 가격
        basePrice = calculatedWeight * pricePerKg;
        
        // 원산지별 추가 비용 계산
        let originAdditionalCost = 0;
        let originPricePerKg = 0;
        
        if (selectedOrigin && originPriceData && originPriceData[selectedOrigin] !== undefined) {
            originPricePerKg = parseFloat(originPriceData[selectedOrigin]) || 0;
            originAdditionalCost = calculatedWeight * originPricePerKg;
        }
        
        // 재질별 추가 비용 계산
        let materialAdditionalCost = 0;
        let materialPricePerKg = 0;
        
        if (material && materialPriceData && materialPriceData[material] !== undefined) {
            materialPricePerKg = parseFloat(materialPriceData[material]) || 0;
            materialAdditionalCost = calculatedWeight * materialPricePerKg;
        }
        
        // 최종 가격
        const totalPrice = basePrice + originAdditionalCost + materialAdditionalCost;
        
        // 계산 과정에 견적금액 추가
        calculationSteps.push(`기본 금액: ${calculatedWeight.toFixed(1)}kg × ${pricePerKg.toLocaleString()}원/kg = ${basePrice.toLocaleString()}원`);
        
        if (selectedOrigin && originPricePerKg !== 0) {
            const sign = originPricePerKg > 0 ? '+' : '';
            calculationSteps.push(`원산지(${selectedOrigin}) 추가비용: ${calculatedWeight.toFixed(1)}kg × ${sign}${originPricePerKg.toLocaleString()}원/kg = ${sign}${originAdditionalCost.toLocaleString()}원`);
        }
        
        if (material && materialPricePerKg !== 0) {
            const sign = materialPricePerKg > 0 ? '+' : '';
            calculationSteps.push(`재질(${material}) 추가비용: ${calculatedWeight.toFixed(1)}kg × ${sign}${materialPricePerKg.toLocaleString()}원/kg = ${sign}${materialAdditionalCost.toLocaleString()}원`);
        }
        
        calculationSteps.push(`최종 금액: ${totalPrice.toLocaleString()}원`);
        
        // 결과 표시
        document.getElementById('calcResultValue').textContent = calculatedWeight.toFixed(1) + ' kg';
        document.getElementById('calcResultPrice').textContent = '견적금액: ' + totalPrice.toLocaleString() + '원';
        
        // 계산 과정 표시
        const stepsHtml = calculationSteps.map(step => 
            `<div class="calc-step">${step}</div>`
        ).join('');
        document.getElementById('calcSteps').innerHTML = stepsHtml;
        
        // 결과 영역 표시
        document.getElementById('calcResult').style.display = 'block';
        <?php endif; ?>
    }
    
    // 디바운스 함수
    let calculateTimer;
    function debouncedCalculate() {
        clearTimeout(calculateTimer);
        calculateTimer = setTimeout(calculateWeight, 300);
    }
    
    // 이벤트 리스너 등록
    document.addEventListener('DOMContentLoaded', function() {
        // 입력 필드에 이벤트 리스너 추가
        const materialSelect = document.getElementById('calc-material');
        if (materialSelect) {
            materialSelect.addEventListener('change', debouncedCalculate);
        }
        
        const quantityInput = document.getElementById('calc-quantity');
        if (quantityInput) {
            quantityInput.addEventListener('input', debouncedCalculate);
        }
        
        const lengthInput = document.getElementById('calc-length');
        if (lengthInput) {
            // select 요소인 경우 change 이벤트 사용
            if (lengthInput.tagName === 'SELECT') {
                lengthInput.addEventListener('change', function() {
                    if (typeof updateBundleInfo === 'function') {
                        updateBundleInfo();
                    }
                    debouncedCalculate();
                });
            } else {
                lengthInput.addEventListener('input', debouncedCalculate);
            }
        }
        
        // 원산지 선택 시에도 계산 업데이트
        const originSelect = document.getElementById('origin-select');
        if (originSelect) {
            originSelect.addEventListener('change', debouncedCalculate);
        }
        
        // 철근 제품인 경우 첫 번째 길이 옵션 자동 선택
        <?php if ($product['category_code'] === 'rebar'): ?>
        const lengthSelect = document.getElementById('calc-length');
        if (lengthSelect && lengthSelect.options.length > 1) {
            lengthSelect.selectedIndex = 1; // 첫 번째 실제 옵션 선택
            if (typeof updateBundleInfo === 'function') {
                updateBundleInfo();
            }
        }
        <?php endif; ?>
        
        // 페이지 로드 시 초기 계산 실행
        console.log('DOMContentLoaded: About to call calculateWeight');
        console.log('calculateWeight function exists:', typeof calculateWeight);
        console.log('bundleData exists:', typeof bundleData);
        console.log('materialPrices exists:', typeof materialPrices);
        
        // 약간의 지연 후 계산 실행 (모든 요소가 준비될 때까지)
        setTimeout(function() {
            console.log('Calling calculateWeight after delay');
            calculateWeight();
        }, 100);
    });
    </script>
    <?php endif; ?>

    <?php
    require_once 'tail.php';
    ?>

} else { 
    // elseif ($category_code) 블록을 else로 변경하고 내부에서 조건 확인
    if ($category_code) {
    // 기존 계산기 페이지 코드
    
    // 제품 정보 조회
    $stmt = $pdo->prepare("
        SELECT p.*, pc.category_name 
        FROM products p 
        JOIN product_categories pc ON p.category_code = pc.category_code 
        WHERE p.category_code = ? AND p.has_calculator = 1
        LIMIT 1
    ");
    $stmt->execute([$category_code]);
    $product = $stmt->fetch(PDO::FETCH_ASSOC);
    
    if (!$product) {
        header('Location: products.php');
        exit;
    }
    
    // JSON 데이터 파싱
    $unit_weight_data = json_decode($product['unit_weight_data'], true) ?? [];
    $available_materials = json_decode($product['available_materials'], true) ?? [];
    $available_sizes = json_decode($product['available_sizes'], true) ?? [];
    
    $pageTitle = $product['product_name'] . ' 계산기';
    $additionalCSS = [];
    require_once 'head.php';
    ?>
    
    <style>
